---
import Layout from '../../layouts/Layout.astro';
import ThTooltip from '../../components/ThTooltip.astro';
import TeamBadge from '../../components/TeamBadge.astro';
import { getTeam, getRoster } from '../../lib/db';

const id = Number(Astro.params.id);
const team = Number.isNaN(id) ? null : await getTeam(id);
const roster = team ? await getRoster(id) : [];
if (!team) Astro.response.status = 404;

const statColumns = [
	{ label: 'Nombre' },
	{ label: 'Dorsal', align: 'text-right' },
	{ label: 'PJ', align: 'text-right' },
	{ label: 'Puntos', align: 'text-right' },
	{ label: 'Pts/PJ', align: 'text-right' },
	{ label: '2P', align: 'text-right' },
	{ label: '3P', align: 'text-right' },
	{ label: 'TL%', align: 'text-right' },
	{ label: 'Faltas', align: 'text-right' },
];
---

<Layout
	title={
		team
			? `${team.name} · Liga Elche Baloncesto`
			: 'Equipo · Liga Elche Baloncesto'
	}
	description={
		team
			? `Plantilla y estadísticas de ${team.name} en la Liga Elche Baloncesto.`
			: undefined
	}
>
	{
		team ? (
			<div class="mx-auto max-w-5xl px-4 py-8">
				<div class="flex items-stretch gap-4 sm:gap-6">
					<div class="flex min-w-0 flex-1 flex-col sm:min-h-[8rem] sm:justify-between">
						<h1 class="font-display text-2xl tracking-wide sm:text-5xl sm:leading-none">
							{team.name}
						</h1>
						<div>
							<p class="text-sm text-gray-500">
								{team.wins} victorias · {team.losses} derrotas · {team.played}{' '}
								{team.played === 1 ? 'partido' : 'partidos'}
							</p>
							<p class="mt-2">
								<a
									href="/equipos"
									class="text-sm font-medium text-[#79131f] hover:underline"
								>
									← Todos los equipos
								</a>
							</p>
							<div class="mt-6 hidden w-full max-w-md sm:block">
								<input
									data-filter-for="#roster-table"
									type="search"
									placeholder="Buscar por nombre o dorsal…"
									class="w-full max-w-md rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#641B24] focus:ring-2 focus:ring-[#641B24]/20"
								/>
							</div>
						</div>
					</div>
					{team.logo_url ? (
						<div class="flex shrink-0 items-start pb-2 pr-2 sm:items-stretch sm:pb-4 sm:pr-4">
							<img
								src={team.logo_url}
								alt=""
								loading="lazy"
								decoding="async"
								class="h-24 w-24 object-contain sm:h-auto sm:w-40"
							/>
						</div>
					) : (
						<TeamBadge
							logoUrl={null}
							name={team.name}
							shortName={team.short_name}
							size="xl"
						/>
					)}
				</div>

				<div class="mt-2 w-full max-w-md sm:hidden">
					<input
						data-filter-for="#roster-table"
						type="search"
						placeholder="Buscar por nombre o dorsal…"
						class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#641B24] focus:ring-2 focus:ring-[#641B24]/20"
					/>
				</div>

				{roster.length === 0 ? (
					<div
						class="mt-4 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
					>
						Este equipo aún no tiene jugadores registrados
					</div>
				) : (
					<div class="mt-4 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
						<table
							data-sortable
							data-animate-rows
							id="roster-table"
							class="w-full text-sm"
						>
							<thead>
								<tr
									class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500"
								>
									{
										statColumns.map((c, i) => (
											<th
												data-sort
												class={[
													'whitespace-nowrap px-3 py-3 font-medium',
													i === 0 ? 'text-left' : 'text-right',
												].join(' ')}
											>
												<ThTooltip label={c.label} />
											</th>
										))
									}
								</tr>
							</thead>
							<tbody>
								{
									roster.map((p) => (
										<tr
											class="border-b border-gray-100 transition-colors last:border-0 hover:bg-[#641B24]/5"
											data-search={`${p.name} ${p.number ?? ''}`}
											data-col0={p.name}
											data-col1={p.number ?? ''}
											data-col2={p.games}
											data-col3={p.points}
											data-col4={p.avg_points ?? ''}
											data-col5={p.fg_made}
											data-col6={p.three_made}
											data-col7={p.ft_pct ?? ''}
											data-col8={p.fouls}
										>
											<td class="px-3 py-2.5 font-medium">{p.name}</td>
											<td class="px-3 py-2.5 text-right tabular-nums text-gray-500">
												{p.number ?? '–'}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">{p.games}</td>
											<td class="px-3 py-2.5 text-right font-medium tabular-nums">
												{p.points}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{p.avg_points !== null ? p.avg_points : '–'}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{p.fg_made}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{p.three_made}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{p.ft_pct !== null ? p.ft_pct : '–'}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">{p.fouls}</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				)}
			</div>
		) : (
			<div class="mx-auto max-w-5xl px-4 py-8">
				<div
					class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Equipo no encontrado.
				</div>
			</div>
		)
	}
</Layout>

<script>
	import '../../lib/table-interactions';
</script>