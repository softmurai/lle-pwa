---
import Layout from '../layouts/Layout.astro';
import { getTeams } from '../lib/db';

const teams = await getTeams();

const colors = [
	'bg-orange-500',
	'bg-blue-500',
	'bg-emerald-600',
	'bg-purple-600',
	'bg-rose-500',
	'bg-teal-600',
	'bg-amber-600',
	'bg-cyan-600',
	'bg-pink-600',
];
const colorFor = (name: string) =>
	colors[[...name].reduce((a, c) => a + c.charCodeAt(0), 0) % colors.length];
---

<Layout
	title="Equipos · Liga Elche Baloncesto"
	description="Todos los equipos de la Liga Elche Baloncesto con su balance de victorias y derrotas."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="font-display text-2xl tracking-wide">Equipos</h1>

		{
			teams.length === 0 ? (
				<div
					class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					No hay equipos registrados.
				</div>
			) : (
				<div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{
						teams.map((t) => (
							<a
								href={`/equipos/${t.id}`}
								class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
							>
								<span
									class={[
										'grid h-11 w-11 shrink-0 place-items-center rounded-xl text-sm font-bold text-white',
										colorFor(t.name),
									].join(' ')}
								>
									{t.short_name.toUpperCase()}
								</span>
								<span class="min-w-0">
									<span
										class="block truncate font-medium"
										title={t.name}
										data-name-full={t.name}
										data-name-short={t.short_name}
									>
										{t.short_name}
									</span>
									<span class="block text-xs text-gray-500">
										{t.wins}V–{t.losses}D · {t.played}{' '}
										{t.played === 1 ? 'partido' : 'partidos'}
									</span>
								</span>
							</a>
						))
					}
				</div>
			)
		}
	</div>
</Layout>

<script>
	import '../lib/team-names';
</script>
