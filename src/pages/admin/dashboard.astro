---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getJornadas } from '../../lib/db';

export const prerender = false;

const admin = Astro.locals.admin;
const jornadas = await getJornadas();

const totalPending = jornadas.reduce((sum, j) => sum + j.pending, 0);
const totalPlayed = jornadas.reduce((sum, j) => sum + j.played, 0);

const fmt = (iso: string) =>
	new Date(`${iso}T00:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
---

<AdminLayout title="Inicio">
	<h1 class="font-display text-3xl tracking-wide text-[#641B24]">Hola, {admin?.username}</h1>
	<p class="mt-1 text-sm text-gray-600">
		Panel de gestión de la liga. {totalPlayed} partidos registrados · {totalPending} pendientes.
	</p>

	<div class="mt-6 grid gap-4 sm:grid-cols-2">
		{
			admin?.role === 'admin' && (
				<a
					href="/admin/jornadas/cambiar"
					class="group rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:border-[#641B24]/40 hover:shadow-md"
				>
					<span class="font-display text-xl tracking-wide text-[#641B24]">Cambio de jornadas</span>
					<p class="mt-1 text-sm text-gray-600">
						Cambiar día, hora o sede de los partidos, o aplazarlos con aviso de conflictos.
					</p>
				</a>
			)
		}
		<a
			href="/admin/actas"
			class="group rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:border-[#641B24]/40 hover:shadow-md"
		>
			<span class="font-display text-xl tracking-wide text-[#641B24]">Registrar actas</span>
			<p class="mt-1 text-sm text-gray-600">
				Introducir el resultado de un partido y las estadísticas de cada jugador.
			</p>
		</a>
	</div>

	<section class="mt-8">
		<h2 class="font-display text-xl tracking-wide text-[#641B24]">Jornadas</h2>
		<div class="mt-3 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 text-left text-xs tracking-wide text-gray-500 uppercase">
					<tr>
						<th class="px-3 py-2 sm:px-4">Jornada</th>
						<th class="px-3 py-2 sm:px-4">Fechas</th>
						<th class="px-3 py-2 text-center sm:px-4">Registrados</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					{
						jornadas.map((j) => (
							<tr class="hover:bg-gray-50">
								<td class="px-3 py-2 font-medium sm:px-4">{j.week}</td>
								<td class="px-3 py-2 text-gray-600 whitespace-nowrap sm:px-4">
									{j.first_date === j.last_date
										? fmt(j.first_date)
										: `${fmt(j.first_date)} – ${fmt(j.last_date)}`}
								</td>
								<td class="px-3 py-2 text-center sm:px-4">
									<a
										href={`/admin/actas/${j.week}`}
										class={
											'inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors ' +
											(j.pending > 0
												? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100'
												: 'border-green-200 bg-green-50 text-green-700 hover:bg-green-100')
										}
										aria-label={
											j.pending > 0
												? `${j.played} de ${j.total} actas registradas · ${j.pending} pendientes`
												: `${j.played} de ${j.total} actas registradas`
										}
										title={
											j.pending > 0
												? `${j.pending} actas pendientes`
												: 'Todas las actas registradas'
										}
									>
										<span>
											{j.played}/{j.total}
										</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M16 4h2a2 2 0 0 1 2 2v2" />
											<path
												d="M21.34 15.664a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"
											/>
											<path d="M8 22H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
											<rect x="8" y="2" width="8" height="4" rx="1" />
										</svg>
									</a>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
</AdminLayout>
