---
import Layout from '../layouts/Layout.astro';
import { getAllPlayers } from '../lib/db';

const players = await getAllPlayers();
---

<Layout
	title="Jugadores · Liga Local Elche"
	description="Busca a cualquier jugador de la Liga Local Elche y consulta sus estadísticas."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-2xl font-bold tracking-tight">Jugadores</h1>
		<p class="mt-1 text-sm text-gray-500">
			Busca a cualquier jugador de la liga.
		</p>

		<input
			data-filter-for="#players-table"
			type="search"
			placeholder="Buscar por nombre…"
			class="mt-4 w-full max-w-md rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-orange-400 focus:ring-2 focus:ring-orange-100"
		/>

		{
			players.length === 0 ? (
				<div
					class="mt-4 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					No hay jugadores registrados.
				</div>
			) : (
				<div class="mt-4 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
					<table
						data-sortable
						data-animate-rows
						id="players-table"
						class="w-full min-w-150 text-sm"
					>
						<thead>
							<tr
								class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500"
							>
								<th data-sort class="px-3 py-3 font-medium">Nombre</th>
								<th data-sort class="px-3 py-3 font-medium">Equipo</th>
								<th data-sort class="px-3 py-3 font-medium text-right">Dorsal</th>
								<th data-sort class="px-3 py-3 font-medium text-right">PJ</th>
								<th data-sort class="px-3 py-3 font-medium text-right">Puntos</th>
							</tr>
						</thead>
						<tbody>
							{
								players.map((p) => (
									<tr
										class="border-b border-gray-100 transition-colors last:border-0 hover:bg-orange-50"
										data-search={`${p.name} ${p.number ?? ''}`}
										data-col0={p.name}
										data-col1={p.team_name}
										data-col2={p.number ?? ''}
										data-col3={p.games}
										data-col4={p.points}
									>
										<td class="px-3 py-2.5 font-medium">{p.name}</td>
										<td class="px-3 py-2.5">
											<a
												href={`/equipos/${p.team_id}`}
												class="text-orange-600 hover:underline"
											>
												{p.team_name}
											</a>
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums text-gray-500">
											{p.number ?? '–'}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums">{p.games}</td>
										<td class="px-3 py-2.5 text-right font-medium tabular-nums">
											{p.points}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			)
		}
	</div>
</Layout>

<script>
	import '../lib/table-interactions';
</script>