---
import Layout from '../layouts/Layout.astro';
import ResultBadge from '../components/ResultBadge.astro';
import type { MatchRow } from '../lib/db';
import { getAllMatches } from '../lib/db';
import { formatDate, formatTime, teamOutcome } from '../lib/format';

const matches = await getAllMatches();
const byWeek = new Map<number, { date: string; matches: MatchRow[] }>();
for (const m of matches) {
	const entry = byWeek.get(m.week) ?? { date: m.date, matches: [] };
	if (!byWeek.has(m.week)) byWeek.set(m.week, entry);
	entry.matches.push(m);
}
const weeks = [...byWeek.entries()];
---

<Layout
	title="Calendario · Liga Local Elche"
	description="Calendario y resultados de todas las jornadas de la Liga Local Elche."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-2xl font-bold tracking-tight">Calendario</h1>

		{
			weeks.length === 0 ? (
				<div
					class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Aún no hay partidos registrados.
				</div>
			) : (
				<div class="mt-6 space-y-8">
					{
						weeks.map(([week, entry]) => (
							<section>
								<div
									class="flex items-baseline justify-between border-b border-gray-200 pb-2"
								>
									<h2 class="text-lg font-semibold">Jornada {week}</h2>
									<span class="text-xs text-gray-500">
										{formatDate(entry.date)}
									</span>
								</div>
								<div class="mt-3 grid gap-3 sm:grid-cols-2">
									{
										entry.matches.map((m) => (
											<a
												href={`/partidos/${m.id}`}
												class="block rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
											>
												<div class="mb-2 text-xs text-gray-500">
													{formatTime(m.time) || formatDate(m.date)}
												</div>
												<div class="flex items-center justify-between gap-3">
													<div class="flex min-w-0 flex-1 items-center gap-1.5">
														<span class="truncate font-medium">
															{m.home_team}
														</span>
														{(() => {
															const outcome = teamOutcome(m, 'home');
															return outcome && <ResultBadge variant={outcome} />;
														})()}
													</div>
													<span class="shrink-0 rounded-lg bg-gray-100 px-3 py-1 text-sm font-bold tabular-nums">
														{m.home_score ?? '–'} – {m.away_score ?? '–'}
													</span>
													<div class="flex min-w-0 flex-1 items-center justify-end gap-1.5">
														{(() => {
															const outcome = teamOutcome(m, 'away');
															return outcome && <ResultBadge variant={outcome} />;
														})()}
														<span class="truncate text-right font-medium">
															{m.away_team}
														</span>
													</div>
												</div>
											</a>
										))
									}
								</div>
							</section>
						))
					}
				</div>
			)
		}
	</div>
</Layout>