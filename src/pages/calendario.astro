---
import Layout from '../layouts/Layout.astro';
import MatchGrid from '../components/MatchGrid.astro';
import type { MatchRow } from '../lib/db';
import { getAllMatches, getSpecialDates } from '../lib/db';
import { formatDate } from '../lib/format';

const matches = await getAllMatches();
const specialDates = await getSpecialDates();
const rainDates = new Set(
	specialDates.filter((s) => s.type === 'lluvia').map((s) => s.date),
);

interface Section {
	key: string;
	title: string;
	date: string;
	endDate?: string;
	matches: MatchRow[];
}

const byWeek = new Map<number, MatchRow[]>();
const byPostponedDate = new Map<string, MatchRow[]>();

for (const m of matches) {
	if (m.original_date && m.original_date !== m.date && rainDates.has(m.date)) {
		const list = byPostponedDate.get(m.date) ?? [];
		list.push(m);
		byPostponedDate.set(m.date, list);
	} else {
		const list = byWeek.get(m.week) ?? [];
		list.push(m);
		byWeek.set(m.week, list);
	}
}

const sections: Section[] = [];

for (const [week, weekMatches] of byWeek) {
	const dates = weekMatches.map((m) => m.date);
	sections.push({
		key: `week-${week}`,
		title: `Jornada ${week}`,
		date: dates.reduce((a, b) => (a < b ? a : b)),
		endDate: dates.reduce((a, b) => (a > b ? a : b)),
		matches: weekMatches,
	});
}

for (const [date, postponed] of byPostponedDate) {
	sections.push({
		key: `aplazada-${date}`,
		title: 'Jornada aplazada',
		date,
		matches: postponed,
	});
}

sections.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
---

<Layout
	title="Calendario · Liga Elche Baloncesto"
	description="Calendario y resultados de todas las jornadas de la Liga Elche Baloncesto."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="font-display text-2xl tracking-wide">Calendario</h1>

		{
			sections.length === 0 ? (
				<div
					class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Aún no hay partidos registrados
				</div>
			) : (
				<div class="mt-6 space-y-8">
					{
						sections.map((section) => (
							<section>
								<div
									class="flex items-baseline justify-between border-b border-gray-200 pb-2"
								>
									<h2 class="text-lg font-semibold">{section.title}</h2>
									<span class="text-xs text-gray-500">
										{section.endDate && section.endDate !== section.date
											? `${formatDate(section.date)} – ${formatDate(section.endDate)}`
											: formatDate(section.date)}
									</span>
								</div>
								<MatchGrid matches={section.matches} />
							</section>
						))
					}
				</div>
			)
		}
	</div>
</Layout>

<script>
	import '../lib/team-names';
</script>
