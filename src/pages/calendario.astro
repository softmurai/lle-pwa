---
import Layout from '../layouts/Layout.astro';
import type { MatchRow } from '../lib/db';
import { getAllMatches } from '../lib/db';
import { formatDate } from '../lib/format';

const matches = await getAllMatches();
const byWeek = new Map<number, { date: string; matches: MatchRow[] }>();
for (const m of matches) {
	const entry = byWeek.get(m.week) ?? { date: m.date, matches: [] };
	if (!byWeek.has(m.week)) byWeek.set(m.week, entry);
	entry.matches.push(m);
}
const weeks = [...byWeek.entries()];
---

<Layout title="Calendario · Liga Local de Baloncesto">
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-2xl font-bold tracking-tight">Calendario</h1>

		{
			weeks.length === 0 ? (
				<div
					class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Aún no hay partidos registrados.
				</div>
			) : (
				<div class="mt-6 space-y-8">
					{
						weeks.map(([week, entry]) => (
							<section>
								<div
									class="flex items-baseline justify-between border-b border-gray-200 pb-2"
								>
									<h2 class="text-lg font-semibold">Jornada {week}</h2>
									<span class="text-xs text-gray-500">
										{formatDate(entry.date)}
									</span>
								</div>
								<div class="mt-3 grid gap-3 sm:grid-cols-2">
									{
										entry.matches.map((m) => (
											<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md">
												<div class="mb-2 text-xs text-gray-500">
													{formatDate(m.date)}
												</div>
												<div class="flex items-center justify-between gap-3">
													<span class="flex-1 truncate font-medium">
														{m.home_team}
													</span>
													<span class="rounded-lg bg-gray-100 px-3 py-1 text-sm font-bold tabular-nums">
														{m.home_score ?? '–'} – {m.away_score ?? '–'}
													</span>
													<span class="flex-1 truncate text-right font-medium">
														{m.away_team}
													</span>
												</div>
												{m.status !== 'finished' && (
													<span class="mt-2 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">
														{m.status.toUpperCase()}
													</span>
												)}
											</article>
										))
									}
								</div>
							</section>
						))
					}
				</div>
			)
		}
	</div>
</Layout>