---
import Layout from '../../layouts/Layout.astro';
import type { BoxScoreRow } from '../../lib/db';
import { getMatch, getMatchBoxScore } from '../../lib/db';
import { formatDate, formatTime } from '../../lib/format';

const rawId = Number(Astro.params.id);
const match = Number.isNaN(rawId) ? null : await getMatch(rawId);
const rows = match ? await getMatchBoxScore(rawId) : [];
if (!match) Astro.response.status = 404;

const homeRows = rows.filter((r) => r.team_id === match?.home_id);
const awayRows = rows.filter((r) => r.team_id === match?.away_id);

const totals = (list: BoxScoreRow[]) =>
	list.reduce(
		(acc, r) => ({
			points: acc.points + r.points,
			fg: acc.fg + r.fg,
			three: acc.three + r.three,
			ft_made: acc.ft_made + r.ft_made,
			ft_att: acc.ft_att + r.ft_att,
			fouls: acc.fouls + r.fouls,
		}),
		{ points: 0, fg: 0, three: 0, ft_made: 0, ft_att: 0, fouls: 0 },
	);

const statHeader = ['P', '2P', '3P', 'TL', 'TLA', 'Fal'];
const boxColumns = [
	{ label: 'Jugador', align: 'text-left' },
	...statHeader.map((label) => ({ label, align: 'text-right' })),
];
---

<Layout
	title={
		match
			? `${match.home_team} vs ${match.away_team} · Liga Local Elche`
			: 'Partido · Liga Local Elche'
	}
	description={
		match
			? `Resultado y estadísticas de ${match.home_team} contra ${match.away_team}, jornada ${match.week} de la Liga Local Elche.`
			: undefined
	}
>
	{
		match ? (
			<div class="mx-auto max-w-5xl px-4 py-8">
				<p>
					<a
						href="/calendario"
						class="text-sm font-medium text-orange-600 hover:underline"
					>
						← Calendario
					</a>
				</p>

				<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
					<span class="font-medium text-gray-700">
						Jornada {match.week}
					</span>
					<span>·</span>
					<span>{formatTime(match.time) || formatDate(match.date)}</span>
					{match.status !== 'finished' && (
						<span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">
							{match.status.toUpperCase()}
						</span>
					)}
				</div>

				<div class="mt-4 flex items-center justify-between gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
					<span class="flex-1 truncate text-lg font-semibold">
						{match.home_team}
					</span>
					<span class="rounded-xl bg-gray-900 px-5 py-2 text-xl font-bold text-white tabular-nums">
						{match.home_score ?? '–'} – {match.away_score ?? '–'}
					</span>
					<span class="flex-1 truncate text-right text-lg font-semibold">
						{match.away_team}
					</span>
				</div>

				{
					rows.length === 0 ? (
						<div
							class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
						>
							Aún no hay estadísticas de jugadores para este partido.
						</div>
					) : (
						<div class="mt-6 space-y-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-6 lg:space-y-0">
							{[
								{ teamName: match.home_team, rows: homeRows },
								{ teamName: match.away_team, rows: awayRows },
							].map(({ teamName, rows: teamRows }) => {
								const t = totals(teamRows);
								return (
									<section
										class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
									>
										<h2 class="border-b border-gray-200 bg-gray-50 px-4 py-3 font-semibold">
											{teamName}
										</h2>
										<div class="overflow-x-auto">
											<table class="w-full min-w-90 text-sm">
												<thead>
													<tr
														class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500"
													>
														{
															boxColumns.map((c, i) => (
																<th
																	class={[
																		'whitespace-nowrap px-3 py-2.5 font-medium',
																		i === 0
																			? 'text-left'
																			: 'text-right',
																	].join(' ')}
																>
																	{c.label}
																</th>
															))
														}
													</tr>
												</thead>
												<tbody>
													{teamRows.map((r) => (
														<tr class="border-b border-gray-100 last:border-0">
															<td class="px-3 py-2 font-medium">
																<span class="text-gray-400">
																	{r.player_number ?? '–'}
																</span>{' '}
																{r.player_name}
															</td>
															<td class="px-3 py-2 text-right font-medium tabular-nums">
																{r.points}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.fg}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.three}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.ft_made}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.ft_att}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.fouls}
															</td>
														</tr>
													))}
												</tbody>
												<tfoot>
													<tr class="border-t-2 border-gray-200 bg-gray-50 font-semibold">
														<td class="px-3 py-2">Totales</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.points}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.fg}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.three}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.ft_made}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.ft_att}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.fouls}
														</td>
													</tr>
												</tfoot>
											</table>
										</div>
									</section>
								);
							})}
						</div>
					)
				}
			</div>
		) : (
			<div class="mx-auto max-w-5xl px-4 py-8">
				<div
					class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Partido no encontrado.
				</div>
			</div>
		)
	}
</Layout>