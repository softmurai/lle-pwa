---
import Layout from '../../layouts/Layout.astro';
import ThTooltip from '../../components/ThTooltip.astro';
import TeamBadge from '../../components/TeamBadge.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import VenueLink from '../../components/VenueLink.astro';
import MovedBadge from '../../components/MovedBadge.astro';
import QuarterChart from '../../components/QuarterChart.astro';
import type { BoxScoreRow } from '../../lib/db';
import { getMatch, getMatchBoxScore } from '../../lib/db';
import { MAX_FOULS } from '../../lib/validation/match-acta';
import { formatDate, formatTime, formatTurno, isTbdVenue, movedLabel, teamOutcome, type TeamOutcome } from '../../lib/format';

const rawId = Number(Astro.params.id);
const match = Number.isNaN(rawId) ? null : await getMatch(rawId);
const rows = match ? await getMatchBoxScore(rawId) : [];
if (!match) Astro.response.status = 404;

/**
 * Unconfirmed venues show the turno label instead of the raw hour, since the
 * time is only a pre-structured slot until the admin confirms it. The label is
 * trusted HTML (superscript ordinal), so it is rendered with `set:html`.
 */
const matchTimeLabel = match
	? isTbdVenue(match.venue_maps)
		? formatTurno(match.time) || formatTime(match.time)
		: formatTime(match.time)
	: '';

const homeRows = rows.filter((r) => r.team_id === match?.home_id);
const awayRows = rows.filter((r) => r.team_id === match?.away_id);

const homePeriods = [
	match?.home_q1 ?? null,
	match?.home_q2 ?? null,
	match?.home_q3 ?? null,
	match?.home_q4 ?? null,
	match?.home_ot1 ?? null,
	match?.home_ot2 ?? null,
	match?.home_ot3 ?? null,
];
const awayPeriods = [
	match?.away_q1 ?? null,
	match?.away_q2 ?? null,
	match?.away_q3 ?? null,
	match?.away_q4 ?? null,
	match?.away_ot1 ?? null,
	match?.away_ot2 ?? null,
	match?.away_ot3 ?? null,
];
const hasQuarterScores = [...homePeriods, ...awayPeriods].some((v) => v != null);

const totals = (list: BoxScoreRow[]) =>
	list.reduce(
		(acc, r) => ({
			points: acc.points + r.points,
			fg: acc.fg + r.fg,
			three: acc.three + r.three,
			ft_made: acc.ft_made + r.ft_made,
			ft_att: acc.ft_att + r.ft_att,
			fouls: acc.fouls + r.fouls,
		}),
		{ points: 0, fg: 0, three: 0, ft_made: 0, ft_att: 0, fouls: 0 },
	);

const statHeader = ['P', '2P', '3P', 'TL', 'TLI', 'Fal'];
const boxColumns = [
	{ label: 'Jugador', align: 'text-left' },
	...statHeader.map((label) => ({ label, align: 'text-right' })),
];

const homeOutcome = match ? teamOutcome(match, 'home') : null;
const awayOutcome = match ? teamOutcome(match, 'away') : null;
const moved = match ? movedLabel(match.original_date, match.date) : null;
const nameClasses = (outcome: TeamOutcome | null, align: '' | 'text-right') => {
	const base = `truncate font-display uppercase tracking-wide ${align}`;
	if (!outcome) return `${base} text-lg sm:text-3xl`;
	if (outcome === 'win') return `${base} rounded-lg bg-emerald-100 px-3 py-1 text-xl text-emerald-700 sm:text-3xl`;
	return `${base} rounded-lg bg-rose-100 px-3 py-1 text-xl text-rose-700 sm:text-3xl`;
};
---

<Layout
	title={
		match
			? `${match.home_team} vs ${match.away_team} · Liga Elche Baloncesto`
			: 'Partido · Liga Elche Baloncesto'
	}
	description={
		match
			? `Resultado y estadísticas de ${match.home_team} contra ${match.away_team}, jornada ${match.week} de la Liga Elche Baloncesto.`
			: undefined
	}
>
	{
		match ? (
			<div class="mx-auto max-w-5xl px-4 pt-4 pb-6">
				<div class="flex items-center justify-between gap-3 sm:hidden">
					<div class="flex min-w-0 flex-col text-sm text-gray-500">
						<a
							href="/calendario"
							class="text-sm font-medium text-[#79131f] hover:underline"
						>
							← Calendario
						</a>
						<h1 class="mt-1 font-display text-3xl tracking-wide text-black">
							Jornada {match.week}
						</h1>
						<div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
							{match.time && (
								<>
									<span set:html={matchTimeLabel} />
								</>
							)}
							<span class="mr-1">{formatDate(match.date)}</span>
							{match.venue_name && (
								<>
									<VenueLink
										name={match.venue_name}
										short={match.venue_short}
										mapsUrl={match.venue_maps}
										class="hover:text-[#79131f] hover:underline"
									/>
								</>
							)}
						</div>
					</div>
					<span class="flex shrink-0 items-center gap-2">
						<a href={`/equipos/${match.home_id}`} class="shrink-0">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.home_logo}
								name={match.home_team}
								shortName={match.home_short}
							/>
						</a>
						<span class="font-display text-2xl text-black">
							VS
						</span>
						<a href={`/equipos/${match.away_id}`} class="shrink-0">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.away_logo}
								name={match.away_team}
								shortName={match.away_short}
							/>
						</a>
					</span>
				</div>

				<p class="hidden sm:block">
					<a
						href="/calendario"
						class="text-sm font-medium text-[#79131f] hover:underline"
					>
						← Calendario
					</a>
				</p>

				<h1 class="mt-3 hidden font-display text-3xl tracking-wide text-black sm:block">
					Jornada {match.week}
				</h1>
				<div class="mt-1 hidden flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 sm:flex">
					{match.time && (
						<>
							<span set:html={matchTimeLabel} />
						</>
					)}
					<span class="mr-2">{formatDate(match.date)}</span>
					{match.venue_name && (
						<>
							<VenueLink
								name={match.venue_name}
								short={match.venue_short}
								mapsUrl={match.venue_maps}
								class="hover:text-[#79131f] hover:underline"
							/>
						</>
					)}
				</div>

				<div class="mt-4 flex items-center justify-between gap-2 rounded-2xl border border-gray-200 bg-white p-3 shadow-sm sm:gap-4 sm:p-5">
					<div class="flex min-w-0 flex-1 items-center gap-2 sm:justify-between">
						<a
							href={`/equipos/${match.home_id}`}
							class={`${nameClasses(homeOutcome, '')} transition hover:opacity-80`}
							title={match.home_team}
							data-name-full={match.home_team}
							data-name-short={match.home_short}
						>
							{match.home_short}
						</a>
						<a href={`/equipos/${match.home_id}`} class="hidden sm:inline-flex">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.home_logo}
								name={match.home_team}
								shortName={match.home_short}
							/>
						</a>
					</div>
					<ScoreBadge home={match.home_score} away={match.away_score} variant="hero" />
					<div class="flex min-w-0 flex-1 items-center justify-end gap-2 sm:justify-between">
						<a href={`/equipos/${match.away_id}`} class="hidden sm:inline-flex">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.away_logo}
								name={match.away_team}
								shortName={match.away_short}
							/>
						</a>
						<a
							href={`/equipos/${match.away_id}`}
							class={`${nameClasses(awayOutcome, 'text-right')} transition hover:opacity-80`}
							title={match.away_team}
							data-name-full={match.away_team}
							data-name-short={match.away_short}
						>
							{match.away_short}
						</a>
					</div>
				</div>

				{
					rows.length === 0 ? (
						<div
							class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
						>
							Aún no hay estadísticas de jugadores para este partido
						</div>
					) : (
						<div class="mt-6 space-y-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-6 lg:space-y-0">
							{[
								{ teamId: match.home_id, teamName: match.home_team, rows: homeRows },
								{ teamId: match.away_id, teamName: match.away_team, rows: awayRows },
							].map(({ teamId, teamName, rows: teamRows }) => {
								const t = totals(teamRows);
								return (
									<section
										class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
									>
										<h2 class="border-b border-gray-200 bg-gray-50 px-4 py-3 font-semibold">
											<a
												href={`/equipos/${teamId}`}
												class="transition hover:text-[#79131f] hover:underline"
											>
												{teamName}
											</a>
										</h2>
										<div class="overflow-x-auto">
											<table data-sortable class="w-full text-sm">
												<thead>
													<tr
														class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500"
													>
														{
															boxColumns.map((c, i) => (
																<th
																	data-sort={i > 0 ? '' : undefined}
																	data-col={i > 0 ? i : undefined}
																	class={[
																		'whitespace-nowrap px-3 py-2.5 font-medium',
																		i === 0
																			? 'text-left'
																			: 'text-right',
																	].join(' ')}
																>
																	<ThTooltip label={c.label} />
																</th>
															))
														}
													</tr>
												</thead>
												<tbody>
													{teamRows.map((r) => (
														<tr
															class="border-b border-gray-100 last:border-0"
															data-col1={r.points}
															data-col2={r.fg}
															data-col3={r.three}
															data-col4={r.ft_made}
															data-col5={r.ft_att}
															data-col6={r.fouls}
														>
															<td class="px-3 py-2 font-medium">
																<span class="text-gray-400">
																	{r.player_number ?? '–'}
																</span>{' '}
																{r.player_name}
															</td>
															<td class="px-3 py-2 text-right font-medium tabular-nums">
																{r.points}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.fg}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.three}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.ft_made}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{r.ft_att}
															</td>
															<td
																class={[
																	'px-3 py-2 text-right tabular-nums',
																	r.fouls >= MAX_FOULS
																		? 'font-bold text-[#641B24]'
																		: '',
																].join(' ')}
															>
																{r.fouls}
															</td>
														</tr>
													))}
												</tbody>
												<tfoot>
													<tr class="border-t-2 border-gray-200 bg-gray-50 font-semibold">
														<td class="px-3 py-2">Totales</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.points}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.fg}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.three}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.ft_made}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.ft_att}
														</td>
														<td class="px-3 py-2 text-right tabular-nums">
															{t.fouls}
														</td>
													</tr>
												</tfoot>
											</table>
										</div>
									</section>
								);
							})}
						</div>
					)
				}

				{
					hasQuarterScores && (
						<div class="mt-6">
							<QuarterChart
								home={homePeriods}
								away={awayPeriods}
								homeName={match.home_team}
								awayName={match.away_team}
								homeShort={match.home_short}
								awayShort={match.away_short}
							/>
						</div>
					)
				}

				{
					(moved || match.observations) && (
						<div class="mt-4 space-y-3">
							{moved && match.original_date && (
								<MovedBadge originalDate={match.original_date} date={match.date} />
							)}
							{match.observations && (
								<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
									<h2 class="text-xs font-semibold tracking-wide text-gray-500 uppercase">
										Observaciones
									</h2>
									<p class="mt-1 text-sm whitespace-pre-line text-gray-700">
										{match.observations}
									</p>
								</div>
							)}
						</div>
					)
				}

				{
					match.acta_photo_key && (
						<div class="mt-6">
							<button
								type="button"
								data-acta-open
								class="flex w-full items-center justify-center gap-2.5 rounded-xl bg-[#641B24] px-6 py-3 text-sm font-semibold tracking-wide text-white uppercase shadow-sm transition hover:bg-[#7a2130] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#641B24]/40 focus-visible:ring-offset-2 sm:mx-auto sm:w-fit"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
									<path
										d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
									></path>
									<path d="M12 11h4"></path>
									<path d="M12 16h4"></path>
									<path d="M8 11h.01"></path>
									<path d="M8 16h.01"></path>
								</svg>
								Ver acta
							</button>

							<dialog
								id="acta-dialog"
								aria-label="Acta del partido"
								class="m-auto max-h-none max-w-none border-0 bg-transparent p-0"
							>
								<div data-acta-backdrop class="relative flex items-center justify-center">
									<img
										src={`/${match.acta_photo_key}`}
										alt={`Acta del partido ${match.home_team} contra ${match.away_team}`}
										loading="eager"
										decoding="async"
										class="h-auto max-h-[85dvh] w-auto max-w-[92vw] rounded-xl bg-white object-contain shadow-2xl"
									/>
								</div>
								<button
									type="button"
									data-acta-close
									aria-label="Cerrar"
									class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-white transition hover:bg-black/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M18 6 6 18"></path>
										<path d="m6 6 12 12"></path>
									</svg>
								</button>
							</dialog>
						</div>
					)
				}
			</div>
		) : (
			<div class="mx-auto max-w-5xl px-4 pt-4 pb-6">
				<div
					class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Partido no encontrado.
				</div>
			</div>
		)
	}
</Layout>

<script>
	import '../../lib/team-names';
	import '../../lib/table-interactions';

	const dialog = document.getElementById('acta-dialog') as HTMLDialogElement | null;
	const openBtn = document.querySelector<HTMLButtonElement>('[data-acta-open]');
	const closeBtn = document.querySelector<HTMLButtonElement>('[data-acta-close]');

	if (dialog && openBtn) {
		openBtn.addEventListener('click', () => dialog.showModal());
		closeBtn?.addEventListener('click', () => dialog.close());
		// Clicking the dimmed backdrop — or the framing area around the photo —
		// closes the viewer. ESC is handled natively by <dialog>.
		dialog.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			const isPhoto = target?.closest('img') != null;
			if (isPhoto) return;
			if (target === dialog || target?.hasAttribute('data-acta-backdrop')) dialog.close();
		});
	}
</script>

<style is:global>
	#acta-dialog::backdrop {
		background-color: rgb(0 0 0 / 0.7);
	}
</style>
