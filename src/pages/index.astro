---
import Layout from '../layouts/Layout.astro';
import { getStandings, getLatestWeek, getWeekMatches } from '../lib/db';
import { formatDate, formatTime } from '../lib/format';

const latestWeek = await getLatestWeek();
const matches = latestWeek !== null ? await getWeekMatches(latestWeek) : [];
const standings = await getStandings(5);
---

<Layout
	title="Liga Local Elche"
	description="Partidos, clasificación y estadísticas de la Liga Local Elche. Actualizados cada sábado."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<section
			class="rounded-2xl bg-gradient-to-br from-orange-500 to-orange-600 px-6 py-8 text-white shadow-md"
		>
			<h1 class="text-2xl font-bold sm:text-3xl">Liga Local Elche</h1>
			<p class="mt-1 text-sm text-orange-100">
				Partidos y estadísticas — actualizados cada sábado.
			</p>
		</section>

		{
			latestWeek !== null ? (
				<>
					<section class="mt-8">
						<div class="flex items-baseline justify-between">
							<h2 class="text-xl font-semibold">
								Jornada {latestWeek}
								{
									matches.length > 0 && (
										<span class="ml-2 text-sm font-normal text-gray-400">
											{formatDate(matches[0].date)}
										</span>
									)
								}
							</h2>
							<a
								href="/calendario"
								class="text-sm font-medium text-orange-600 hover:underline"
							>
								Todo el calendario →
							</a>
						</div>

						{matches.length === 0 ? (
							<p class="mt-3 text-sm text-gray-500">
								No hay partidos registrados para esta jornada.
							</p>
						) : (
							<div class="mt-3 grid gap-3 sm:grid-cols-2">
								{matches.map((m) => (
									<a
										href={`/partidos/${m.id}`}
										class="block rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
									>
										<div class="mb-2 text-xs text-gray-500">
											{formatTime(m.time) || formatDate(m.date)}
										</div>
										<div class="flex items-center justify-between gap-3">
											<span class="flex-1 truncate font-medium">
												{m.home_team}
											</span>
											<span class="rounded-lg bg-gray-100 px-3 py-1 text-sm font-bold tabular-nums">
												{m.home_score ?? '–'} – {m.away_score ?? '–'}
											</span>
											<span class="flex-1 truncate text-right font-medium">
												{m.away_team}
											</span>
										</div>
										{m.status !== 'finished' && (
											<span class="mt-2 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">
												{m.status.toUpperCase()}
											</span>
										)}
									</a>
								))}
							</div>
						)}
					</section>

					{standings.length > 0 && (
						<section class="mt-8">
							<div class="flex items-baseline justify-between">
								<h2 class="text-xl font-semibold">Clasificación</h2>
								<a
									href="/clasificacion"
									class="text-sm font-medium text-orange-600 hover:underline"
								>
									Ver completa →
								</a>
							</div>

							<div class="mt-3 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
								<table data-animate-rows class="w-full min-w-150 text-sm">
									<thead>
										<tr
											class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500"
										>
											<th class="w-12 px-3 py-3 font-medium">#</th>
											<th class="px-3 py-3 font-medium">Equipo</th>
											<th class="px-3 py-3 font-medium text-right">PJ</th>
											<th class="px-3 py-3 font-medium text-right">V</th>
											<th class="px-3 py-3 font-medium text-right">D</th>
											<th class="px-3 py-3 font-medium text-right">NP</th>
											<th class="px-3 py-3 font-medium text-right">PF</th>
											<th class="px-3 py-3 font-medium text-right">PC</th>
											<th class="px-3 py-3 font-medium text-right">+/-</th>
											<th class="px-3 py-3 font-medium text-right">PTS</th>
											<th class="px-3 py-3 font-medium text-right">RACHA</th>
										</tr>
									</thead>
									<tbody>
										{standings.map((r) => (
											<tr class="border-b border-gray-100 last:border-0">
												<td class="px-3 py-2.5 font-semibold text-gray-400">
													<span data-pos>{r.position}</span>
												</td>
												<td class="px-3 py-2.5 font-medium">
													<a
														href={`/equipos/${r.id}`}
														class="text-gray-900 hover:text-orange-600 hover:underline"
													>
														{r.name}
													</a>
												</td>
<td class="px-3 py-2.5 text-right tabular-nums">
												{r.played}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums text-emerald-600">
												{r.wins}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums text-rose-600">
												{r.losses}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums text-gray-700">
												{r.forfeits}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{r.points_for}
											</td>
											<td class="px-3 py-2.5 text-right tabular-nums">
												{r.points_against}
											</td>
											<td
												class={[
													'px-3 py-2.5 text-right font-medium tabular-nums',
													r.diff > 0
														? 'text-emerald-600'
														: r.diff < 0
															? 'text-rose-600'
															: 'text-gray-500',
												].join(' ')}
											>
												{r.diff > 0 ? `+${r.diff}` : r.diff}
											</td>
											<td class="px-3 py-2.5 text-right font-semibold tabular-nums">
												{r.points}
											</td>
											<td class="px-3 py-2.5 text-right">
												<span class="inline-flex justify-end gap-1">
													{
														Array.from({ length: 5 }, (_, i) => {
															const res = r.form[i];
															const cls =
																res === undefined
																	? 'bg-gray-200'
																	: res === 'W'
																		? 'bg-emerald-500'
																		: res === 'F'
																			? 'bg-gray-900'
																			: 'bg-rose-500';
															return (
																<span
																	class={[
																		'inline-block h-2 w-2 rounded-full',
																		cls,
																	].join(' ')}
																></span>
															);
														})
													}
												</span>
											</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</section>
					)}
				</>
			) : (
				<div
					class="mt-8 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
				>
					Aún no hay datos importados. Los datos se añaden cada sábado por la
					noche.
				</div>
			)
		}
	</div>
</Layout>