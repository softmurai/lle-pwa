---
import Layout from '../layouts/Layout.astro';
import MatchGrid from '../components/MatchGrid.astro';
import ThTooltip from '../components/ThTooltip.astro';
import { getStandings, getLastPlayedWeek, getUpcomingWeek, getWeekMatches } from '../lib/db';
import { formatDate } from '../lib/format';

const lastPlayedWeek = await getLastPlayedWeek();
const upcomingWeek = await getUpcomingWeek(lastPlayedWeek);
const upcomingMatches = upcomingWeek !== null ? await getWeekMatches(upcomingWeek) : [];
const lastPlayedMatches = lastPlayedWeek !== null ? await getWeekMatches(lastPlayedWeek) : [];
const standings = await getStandings(5);

const upcomingDate = upcomingMatches[0]?.date ?? null;
const lastPlayedDate = lastPlayedMatches[0]?.date ?? null;
const hasSchedule = upcomingWeek !== null || lastPlayedWeek !== null;
---

<Layout
	title="Liga Elche Baloncesto"
	description="Partidos, clasificación y estadísticas de la Liga Elche Baloncesto. Actualizados cada sábado."
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="sr-only">Liga Elche Baloncesto</h1>

		{
			lastPlayedWeek !== null && (
				<section>
					<div class="flex items-baseline justify-between gap-3">
						<h2 class="font-display text-2xl tracking-wide">ÚLTIMA JORNADA</h2>
						<a
							href="/calendario"
							class="shrink-0 text-sm font-medium text-[#79131f] hover:underline"
						>
							Ver resultados →
						</a>
					</div>
					<p class="mt-0.5 text-sm text-gray-400">
						Jornada {lastPlayedWeek}
						{lastPlayedDate ? ` · ${formatDate(lastPlayedDate)}` : ''}
					</p>
					<MatchGrid matches={lastPlayedMatches} />
				</section>
			)
		}

		{
			upcomingWeek !== null && (
				<section class={lastPlayedWeek !== null ? 'mt-8' : undefined}>
					<div class="flex items-baseline justify-between gap-3">
						<h2 class="font-display text-2xl tracking-wide">PRÓXIMA JORNADA</h2>
						<a
							href="/calendario"
							class="shrink-0 text-sm font-medium text-[#79131f] hover:underline"
						>
							Todo el calendario →
						</a>
					</div>
					<p class="mt-0.5 text-sm text-gray-400">
						Jornada {upcomingWeek}
						{upcomingDate ? ` · ${formatDate(upcomingDate)}` : ''}
					</p>
					{upcomingMatches.length === 0 ? (
						<p class="mt-3 text-sm text-gray-500">
							No hay partidos registrados para esta jornada.
						</p>
					) : (
						<MatchGrid matches={upcomingMatches} />
					)}
				</section>
			)
		}

		{
			standings.length > 0 && (
				<section class="mt-8">
					<div class="flex items-baseline justify-between gap-3">
						<h2 class="font-display text-2xl tracking-wide">CLASIFICACIÓN</h2>
						<a
							href="/clasificacion"
							class="shrink-0 text-sm font-medium text-[#79131f] hover:underline"
						>
							Ver completa →
						</a>
					</div>

					<div class="mt-3 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
						<table data-animate-rows class="w-full text-sm">
							<thead>
								<tr class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
									<th class="w-12 px-3 py-3 font-medium">#</th>
									<th class="px-3 py-3 font-medium">Equipo</th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="PJ" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="V" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="D" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="E" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="NP" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="PF" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="PC" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="+/-" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="PTS" /></th>
									<th class="px-3 py-3 font-medium text-right"><ThTooltip label="RACHA" /></th>
								</tr>
							</thead>
							<tbody>
								{standings.map((r) => (
									<tr class="border-b border-gray-100 last:border-0">
										<td class="px-3 py-2.5 font-semibold text-gray-400">
											<span data-pos>{r.position}</span>
										</td>
										<td class="px-3 py-2.5 font-medium">
											<a
												href={`/equipos/${r.id}`}
												class="text-gray-900 hover:text-[#79131f] hover:underline"
											>
												{r.name}
											</a>
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums">
											{r.played}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums text-emerald-600">
											{r.wins}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums text-rose-600">
											{r.losses}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums text-amber-600">
											{r.ties}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums text-gray-700">
											{r.forfeits}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums">
											{r.points_for}
										</td>
										<td class="px-3 py-2.5 text-right tabular-nums">
											{r.points_against}
										</td>
										<td
											class={[
												'px-3 py-2.5 text-right font-medium tabular-nums',
												r.diff > 0
													? 'text-emerald-600'
													: r.diff < 0
														? 'text-rose-600'
														: 'text-gray-500',
											].join(' ')}
										>
											{r.diff > 0 ? `+${r.diff}` : r.diff}
										</td>
										<td class="px-3 py-2.5 text-right font-semibold tabular-nums">
											{r.points}
										</td>
										<td class="px-3 py-2.5 text-right">
											<span class="inline-flex justify-end gap-1">
												{Array.from({ length: 5 }, (_, i) => {
													const res = r.form[i];
													const cls =
														res === undefined
															? 'bg-gray-200'
															: res === 'W'
																? 'bg-emerald-500'
																: res === 'T'
																	? 'bg-amber-400'
																	: res === 'F'
																		? 'bg-gray-900'
																		: 'bg-rose-500';
													return (
														<span
															class={['inline-block h-2 w-2 rounded-full', cls].join(' ')}
														></span>
													);
												})}
											</span>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			)
		}

		{
			!hasSchedule && standings.length === 0 && (
				<div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
					Aún no hay datos importados
				</div>
			)
		}
	</div>
</Layout>

<script>
	import '../lib/team-names';
</script>
