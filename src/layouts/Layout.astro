---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Clasificación, calendario y estadísticas de la Liga Elche Baloncesto.',
} = Astro.props;
const cardUrl = new URL('/icon-512.png', Astro.url.origin);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#641B24" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Liga Elche Baloncesto" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={cardUrl.toString()} />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-gray-100 text-gray-900 antialiased">
		<div id="ptr-indicator" class="ptr-indicator" aria-hidden="true">
			<svg
				class="ptr-spinner"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 256 256"
				fill="currentColor"
			>
				<path
					d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM60,72.17A87.2,87.2,0,0,1,79.63,120H40.37A87.54,87.54,0,0,1,60,72.17ZM136,120V40.37a87.59,87.59,0,0,1,48.68,20.37A103.06,103.06,0,0,0,160.3,120Zm-16,0H95.7A103.06,103.06,0,0,0,71.32,60.74,87.59,87.59,0,0,1,120,40.37ZM79.63,136A87.2,87.2,0,0,1,60,183.83,87.54,87.54,0,0,1,40.37,136Zm16.07,0H120v79.63a87.59,87.59,0,0,1-48.68-20.37A103.09,103.09,0,0,0,95.7,136Zm40.3,0h24.3a103.09,103.09,0,0,0,24.38,59.26A87.59,87.59,0,0,1,136,215.63Zm40.37,0h39.26A87.54,87.54,0,0,1,196,183.83,87.2,87.2,0,0,1,176.37,136Zm0-16A87.2,87.2,0,0,1,196,72.17,87.54,87.54,0,0,1,215.63,120Z"
				/>
			</svg>
		</div>
		<Nav />
		<main class="flex-1">
			<slot />
		</main>
		<footer
			class="order-t border-gray-200 bg-white py-6 text-center text-xs text-gray-400"
		>
			Liga Elche Baloncesto · Datos importados semanalmente
		</footer>
		<BottomNav />
	</body>
</html>

<script>
	import '../lib/pull-to-refresh';

	if ('serviceWorker' in navigator && import.meta.env.PROD) {
		window.addEventListener('load', () => {
			navigator.serviceWorker.register('/sw.js').catch(() => {});
		});
	}
</script>