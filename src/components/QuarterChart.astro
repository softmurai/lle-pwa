---
interface Props {
	/** Q1..Q4 followed by OT1..OT3 (7 slots, null when unplayed). */
	home: (number | null)[];
	away: (number | null)[];
	homeName: string;
	awayName: string;
	homeShort?: string;
	awayShort?: string;
}

const { home, away, homeName, awayName, homeShort, awayShort } = Astro.props;

const QUARTER_COUNT = 4;
const OT_LABELS = ['PR1', 'PR2', 'PR3'];

// Include overtime periods up to the last one that either team scored in.
let otCount = 0;
for (let i = 0; i < OT_LABELS.length; i++) {
	if (home[QUARTER_COUNT + i] != null || away[QUARTER_COUNT + i] != null) otCount = i + 1;
}

// Team colours: a red and a blue in the brand family, brightened so the two
// lines are easy to tell apart on a light background.
const HOME_COLOR = '#B21E2B';
const AWAY_COLOR = '#1F5FBF';

// A quarter takes a full slot; overtime takes half, since it is half the time played.
// Points sit on slot boundaries so each segment spans exactly its period's width.
const QW = 76;
const OTW = 38;
const slots: { label: string; width: number; index: number }[] = [];
for (let i = 0; i < QUARTER_COUNT; i++) slots.push({ label: `${i + 1}C`, width: QW, index: i });
for (let i = 0; i < otCount; i++) {
	slots.push({ label: OT_LABELS[i], width: OTW, index: QUARTER_COUNT + i });
}

const cumulative = (values: (number | null)[]) => {
	let sum = 0;
	return slots.map((s) => (sum += values[s.index] ?? 0));
};

const hasHome = slots.some((s) => home[s.index] != null);
const hasAway = slots.some((s) => away[s.index] != null);

const homeCum = cumulative(home);
const awayCum = cumulative(away);
const peak = Math.max(0, ...homeCum, ...awayCum);

// Y axis: one gridline + label every 10 points, with a little headroom for the tags.
const STEP = 10;
const axisMax = Math.max(STEP, Math.ceil((peak + 1) / STEP) * STEP);
const gridLines: number[] = [];
for (let v = 0; v <= axisMax; v += STEP) gridLines.push(v);

// Geometry, in SVG viewBox units.
const PAD_LEFT = 30;
const PAD_RIGHT = 18;
const PAD_TOP = 20;
const PLOT_H = 140;
const PAD_BOTTOM = 28;

const plotW = slots.reduce((acc, s) => acc + s.width, 0);
const width = PAD_LEFT + plotW + PAD_RIGHT;
const height = PAD_TOP + PLOT_H + PAD_BOTTOM;

const xAt = (i: number) => PAD_LEFT + slots.slice(0, i).reduce((acc, s) => acc + s.width, 0);
const yToPx = (v: number) => PAD_TOP + PLOT_H - (v / axisMax) * PLOT_H;

// Both lines start at 0 on the y axis, then one point per period boundary.
const polyline = (values: number[]) =>
	[`${PAD_LEFT},${yToPx(0)}`, ...values.map((v, i) => `${xAt(i + 1)},${yToPx(v)}`)].join(' ');

// One point per period boundary, plus a score tag beside it: the team that is
// ahead at that quarter gets its tag above the point, the trailing team below.
const TAG_ABOVE = 9;
const TAG_BELOW = 16;

const marks = slots.map((_, i) => {
	const hv = homeCum[i];
	const av = awayCum[i];
	const homeLeads = hv >= av;
	return {
		cx: xAt(i + 1),
		home: hasHome
			? { value: hv, y: yToPx(hv), tagY: yToPx(hv) + (homeLeads ? -TAG_ABOVE : TAG_BELOW) }
			: null,
		away: hasAway
			? { value: av, y: yToPx(av), tagY: yToPx(av) + (homeLeads ? TAG_BELOW : -TAG_ABOVE) }
			: null,
	};
});

const summary = `Evolución acumulada por cuartos. ${homeName}: ${homeCum.join(', ')}. ${awayName}: ${awayCum.join(', ')}.`;
---

<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
	<h2
		class="flex items-center justify-between gap-3 border-b border-gray-200 bg-gray-50 px-4 py-3 font-semibold"
	>
		<span>Evolución por cuartos</span>
		<span class="flex items-center gap-3 text-xs font-normal text-gray-500">
			<span class="inline-flex items-center gap-1.5">
				<svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true" class="shrink-0">
					<line
						x1="1"
						y1="5"
						x2="21"
						y2="5"
						stroke={HOME_COLOR}
						stroke-width="2"
						stroke-linecap="round"
					></line>
					<circle cx="11" cy="5" r="3" fill={HOME_COLOR}></circle>
				</svg>
				{homeShort ?? homeName}
			</span>
			<span class="inline-flex items-center gap-1.5">
				<svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true" class="shrink-0">
					<line
						x1="1"
						y1="5"
						x2="21"
						y2="5"
						stroke={AWAY_COLOR}
						stroke-width="2"
						stroke-linecap="round"
					></line>
					<circle cx="11" cy="5" r="3" fill={AWAY_COLOR}></circle>
				</svg>
				{awayShort ?? awayName}
			</span>
		</span>
	</h2>

	<div class="px-4 py-4">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			class="mx-auto h-auto w-full max-w-[640px]"
			role="img"
			aria-label={summary}
			preserveAspectRatio="xMidYMid meet"
		>
			{
				gridLines.map((v) => (
					<g>
						<line
							x1={PAD_LEFT}
							y1={yToPx(v)}
							x2={PAD_LEFT + plotW}
							y2={yToPx(v)}
							stroke={v === 0 ? '#d1d5db' : '#eceef0'}
							stroke-width="1"
						/>
						<text
							x={PAD_LEFT - 7}
							y={yToPx(v) + 3.5}
							text-anchor="end"
							font-size="10"
							fill="#9ca3af"
						>
							{v}
						</text>
					</g>
				))
			}

			{
				slots.map((s) => (
					<text
						x={(xAt(slots.indexOf(s)) + xAt(slots.indexOf(s) + 1)) / 2}
						y={PAD_TOP + PLOT_H + 18}
						text-anchor="middle"
						font-size="10"
						fill="#9ca3af"
					>
						{s.label}
					</text>
				))
			}

			{
				hasHome && (
					<polyline
						points={polyline(homeCum)}
						fill="none"
						stroke={HOME_COLOR}
						stroke-width="2"
						stroke-linejoin="round"
						stroke-linecap="round"
					/>
				)
			}
			{
				hasAway && (
					<polyline
						points={polyline(awayCum)}
						fill="none"
						stroke={AWAY_COLOR}
						stroke-width="2"
						stroke-linejoin="round"
						stroke-linecap="round"
					/>
				)
			}

			{
				marks.map((m) => (
					<>
						{m.home && (
							<>
								<circle cx={m.cx} cy={m.home.y} r="2.6" fill={HOME_COLOR} />
								<text
									x={m.cx}
									y={m.home.tagY}
									text-anchor="middle"
									font-size="10"
									font-weight="600"
									fill={HOME_COLOR}
									stroke="#ffffff"
									stroke-width="3"
									paint-order="stroke"
								>
									{m.home.value}
								</text>
							</>
						)}
						{m.away && (
							<>
								<circle cx={m.cx} cy={m.away.y} r="2.6" fill={AWAY_COLOR} />
								<text
									x={m.cx}
									y={m.away.tagY}
									text-anchor="middle"
									font-size="10"
									font-weight="600"
									fill={AWAY_COLOR}
									stroke="#ffffff"
									stroke-width="3"
									paint-order="stroke"
								>
									{m.away.value}
								</text>
							</>
						)}
					</>
				))
			}
		</svg>
	</div>
</section>
