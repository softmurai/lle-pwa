---
const pathname = Astro.url.pathname;
const links = [
	{
		href: '/calendario',
		label: 'Calendario',
		icon: 'M8 2v4M16 2v4M3 8h18M4 4h16a1 1 0 011 1v16a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1z',
	},
	{
		href: '/clasificacion',
		label: 'Clasificación',
		icon: 'M8 21h8M12 17v4M7 4h10v4a5 5 0 01-10 0V4zM7 7H3a1 1 0 000 2h3M17 7h4a1 1 0 010 2h-4',
	},
	{
		href: '/',
		label: 'Inicio',
		icon: 'M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4V14h4v7h4a1 1 0 001-1V10',
	},
	{
		href: '/equipos',
		label: 'Equipos',
		icon: 'M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z',
	},
	{
		href: '/estadisticas',
		label: 'Estadísticas',
		icon: 'M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14M4 20h14',
	},
];
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav
	aria-label="Navegación principal (móvil)"
	class="fixed inset-x-0 bottom-0 z-20 bg-gradient-to-b from-[#3D2340] to-[#142E5D] md:hidden"
>
	<ul
		class="mx-auto flex max-w-5xl items-stretch pb-[calc(env(safe-area-inset-bottom)+16px)]"
	>
		{
			links.map((l) => (
				<li class="flex-1">
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class={
							'flex flex-col items-center gap-0.5 py-2 text-[11px] text-white transition-colors ' +
							(isActive(l.href)
								? 'font-bold'
								: 'font-medium opacity-80 hover:opacity-100')
						}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d={l.icon}></path>
						</svg>
						<span>{l.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>