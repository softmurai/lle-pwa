const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav
	aria-label="Navegación principal (móvil)"
	class="fixed inset-x-0 bottom-0 z-20 bg-gradient-to-b from-[#3D2340] to-[#142E5D] md:hidden"
>
	<ul
		class="mx-auto flex max-w-5xl items-stretch pb-[calc(env(safe-area-inset-bottom)+16px)]"
	>
		{
			links.map((l) => (
				<li class="flex-1">
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class={
							'flex flex-col items-center gap-0.5 py-2 text-[11px] text-white transition-colors ' +
							(isActive(l.href)
								? 'font-bold'
								: 'font-medium opacity-80 hover:opacity-100')
						}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 256 256"
							aria-hidden="true"
							fill="currentColor"
							set:html={isActive(l.href) ? l.iconFill : l.icon}
						/>
						<span>{l.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
