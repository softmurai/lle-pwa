---
interface Props {
	variant: 'win' | 'loss' | 'forfeit';
}

const { variant } = Astro.props;
const config = {
	win: { label: 'Victoria', text: 'V', classes: 'bg-emerald-100 text-emerald-700 focus-visible:ring-emerald-500' },
	loss: { label: 'Derrota', text: 'D', classes: 'bg-rose-100 text-rose-700 focus-visible:ring-rose-500' },
	forfeit: { label: 'No presentado', text: 'NP', classes: 'bg-amber-100 text-amber-700 focus-visible:ring-amber-500' },
}[variant];
---

<span
	tabindex="0"
	aria-label={config.label}
	class={`group relative inline-flex shrink-0 cursor-help items-center rounded px-1.5 py-0.5 text-[10px] font-bold leading-none tracking-wide focus:outline-none focus-visible:ring-2 ${config.classes}`}
>
	{config.text}
	<span
		class="pointer-events-none absolute -top-1 left-1/2 z-10 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded bg-gray-900 px-2 py-1 text-[11px] font-medium leading-tight text-white opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus:opacity-100 group-active:opacity-100"
	>
		{config.label}
		<span
			class="absolute left-1/2 top-full -mt-1 h-0 w-0 -translate-x-1/2 border-4 border-transparent border-t-gray-900"
		></span>
	</span>
</span>