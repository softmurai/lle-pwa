---
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/clasificacion', label: 'Clasificación' },
	{ href: '/calendario', label: 'Calendario' },
	{ href: '/equipos', label: 'Equipos' },
	{ href: '/estadisticas', label: 'Estadísticas' },
];
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-20 border-b border-gray-800 bg-gradient-to-b from-[#641B24] to-[#3D2340] pt-[env(safe-area-inset-top)] text-white shadow-md">
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4">
		<a href="/" class="flex items-center gap-3 font-display tracking-wide">
			<BrandMark />
			<span class="text-lg sm:text-xl">Liga Elche Baloncesto</span>
		</a>

		<div class="flex items-center gap-1">
			<nav class="hidden items-center gap-1 md:flex">
				{
					links.map((l) => (
						<a
							href={l.href}
							aria-current={isActive(l.href) ? 'page' : undefined}
							class={
								isActive(l.href)
									? 'rounded-lg bg-white/10 px-3 py-1.5 text-sm font-medium text-white'
									: 'rounded-lg px-3 py-1.5 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white'
							}
						>
							{l.label}
						</a>
					))
				}
			</nav>

			<a
				href="/admin"
				aria-label="Administración"
				title="Administración"
				class="rounded-lg p-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M11 10.27 7 3.34" />
					<path d="m11 13.73-4 6.93" />
					<path d="M12 22v-2" />
					<path d="M12 2v2" />
					<path d="M14 12h8" />
					<path d="m17 20.66-1-1.73" />
					<path d="m17 3.34-1 1.73" />
					<path d="M2 12h2" />
					<path d="m20.66 17-1.73-1" />
					<path d="m20.66 7-1.73 1" />
					<path d="m3.34 17 1.73-1" />
					<path d="m3.34 7 1.73 1" />
					<circle cx="12" cy="12" r="2" />
					<circle cx="12" cy="12" r="8" />
				</svg>
			</a>
		</div>
	</div>
</header>
