---
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/clasificacion', label: 'Clasificación' },
	{ href: '/calendario', label: 'Calendario' },
	{ href: '/equipos', label: 'Equipos' },
	{ href: '/estadisticas', label: 'Estadísticas' },
];
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-20 border-b border-gray-800 bg-gradient-to-b from-[#641B24] to-[#3D2340] pt-[env(safe-area-inset-top)] text-white shadow-md">
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4">
		<a href="/" class="flex items-center gap-3 font-display tracking-wide">
			<BrandMark />
			<span class="text-lg sm:text-xl">Liga Elche Baloncesto</span>
		</a>

		<div class="flex items-center gap-1">
			<nav class="hidden items-center gap-1 md:flex">
				{
					links.map((l) => (
						<a
							href={l.href}
							aria-current={isActive(l.href) ? 'page' : undefined}
							class={
								isActive(l.href)
									? 'rounded-lg bg-white/10 px-3 py-1.5 text-sm font-medium text-white'
									: 'rounded-lg px-3 py-1.5 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white'
							}
						>
							{l.label}
						</a>
					))
				}
			</nav>

			<a
				href="/admin"
				aria-label="Administración"
				title="Administración"
				class="rounded-lg p-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path
						d="M11 22c-3.806-1.45-7-3.966-7-9V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v4"
					/>
					<path d="M14.923 16.547 14 16.164" />
					<path d="m14.923 18.843-.923.383" />
					<path d="M16.547 14.923 16.164 14" />
					<path d="m16.547 20.467-.383.924" />
					<path d="m18.843 14.923.383-.923" />
					<path d="m19.225 21.391-.382-.924" />
					<path d="m20.467 16.547.923-.383" />
					<path d="m20.467 18.843.923.383" />
					<circle cx="17.695" cy="17.695" r="3" />
				</svg>
			</a>
		</div>
	</div>
</header>
